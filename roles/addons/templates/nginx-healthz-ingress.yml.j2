---
# =============================================================================
# ALB Healthz Responder & Ingress Configuration
# =============================================================================
# Stage 1 AWS ALB checks HTTP GET :30080/healthz expecting HTTP 200 OK.
# This manifest ensures ingress-nginx immediately serves HTTP 200 on /healthz
# for any Host header matching port 30080, satisfying the ALB target group.
# =============================================================================

apiVersion: v1
kind: ConfigMap
metadata:
  name: alb-healthz-html
  namespace: ingress-nginx
  labels:
    app.kubernetes.io/name: alb-healthz
data:
  index.html: "OK\n"

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: alb-healthz-responder
  namespace: ingress-nginx
  labels:
    app.kubernetes.io/name: alb-healthz
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: alb-healthz
  template:
    metadata:
      labels:
        app.kubernetes.io/name: alb-healthz
    spec:
      containers:
        - name: responder
          image: nginx:alpine
          ports:
            - containerPort: 80
              name: http
          volumeMounts:
            - name: html-volume
              mountPath: /usr/share/nginx/html/healthz
              subPath: index.html
            - name: html-volume
              mountPath: /usr/share/nginx/html/index.html
              subPath: index.html
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 50m
              memory: 32Mi
      volumes:
        - name: html-volume
          configMap:
            name: alb-healthz-html

---
apiVersion: v1
kind: Service
metadata:
  name: alb-healthz-svc
  namespace: ingress-nginx
  labels:
    app.kubernetes.io/name: alb-healthz
spec:
  type: ClusterIP
  ports:
    - port: 80
      targetPort: 80
      protocol: TCP
      name: http
  selector:
    app.kubernetes.io/name: alb-healthz

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: alb-healthz-ingress
  namespace: ingress-nginx
  annotations:
    kubernetes.io/ingress.class: nginx
    nginx.ingress.kubernetes.io/ssl-redirect: "false"
    nginx.ingress.kubernetes.io/proxy-body-size: "1m"
    nginx.ingress.kubernetes.io/server-snippet: |
      location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'OK';
      }
spec:
  ingressClassName: nginx
  rules:
    - http:
        paths:
          - path: /healthz
            pathType: Prefix
            backend:
              service:
                name: alb-healthz-svc
                port:
                  number: 80
